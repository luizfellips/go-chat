POSTGRES_DB=gochat
POSTGRES_USER=gochat
POSTGRES_PASSWORD=gochat
DATABASE_URL=postgres://gochat:gochat@postgres:5432/gochat?sslmode=disable

APP_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
CORS_ORIGIN=http://localhost:5173
WS_TICKET_TTL=30s
SEED_DEMO_USERS=true

VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws/connect

BACKEND_PORT=8080
FRONTEND_PORT=5173

# Login rate limit (requests per minute per IP). Set to 0 to disable (useful for load tests).
LOGIN_RATE_LIMIT_RPM=5
REGISTER_RATE_LIMIT_RPM=10
REFRESH_RATE_LIMIT_RPM=30

# Optional: protect /metrics with Bearer token (leave empty to allow unauthenticated access)
METRICS_TOKEN=

# Optional: comma-separated trusted proxy CIDRs for RealIP middleware
TRUSTED_PROXY_CIDRS=

LOG_FORMAT=console
LOG_LEVEL=info
